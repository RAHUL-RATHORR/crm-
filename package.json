{
  "name": "data",
  "private": true,
  "version": "0.0.1",
  "description": "Trickwrick CRM Web Application",
  "author": "Trickwrick",
  "repository": "https://github.com/RAHUL-RATHORR/crm-",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "vite",
    "build": "npm install --prefix server && vite build",
    "start": "node server/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "make-installer": "electron-builder --win"
  },
  "build": {
    "asar": false,
    "appId": "com.trickwrick.crm",
    "productName": "Trickwrick CRM",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "server/**/*",
      "server/.env",
      "electron.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.svg"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "dmg": {
      "title": "Trickwrick CRM"
    }
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@tailwindcss/vite": "^4.2.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "react": "^19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.3",
    "wait-on": "^9.0.10"
  }
}
